# ==============================================================================
# YouTube Free Tools — Vercel Serverless API & Enhancer Integration Environment
# Copy to `.env.local` for local API development or configure in Vercel Dashboard
# NEVER commit real secrets or expose server secrets with a `VITE_` prefix.
# ==============================================================================

# --- Authentication & Session Security (Required for Video Enhancer Jobs) ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-char-random-hex-secret

# --- S3-Compatible Object Storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO) ---
S3_BUCKET=your-video-enhancer-bucket
S3_REGION=auto
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace-with-s3-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
# Set to "true" for MinIO or path-style S3 endpoints
S3_FORCE_PATH_STYLE=false

# --- External Video Processing Worker (FFmpeg + Optional GPU Real-ESRGAN) ---
# Base URL of your standalone worker service (see `/worker`)
ENHANCER_WORKER_URL=https://worker.your-domain.com
# Shared bearer secret matching the worker service's ENHANCER_WORKER_SECRET
ENHANCER_WORKER_SECRET=replace-with-shared-worker-bearer-secret

# --- Optional Distributed Rate Limiting (Upstash Redis REST) ---
# Falls back to per-instance in-memory sliding window when omitted
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional Upload & Job Limits ---
MAX_UPLOAD_MB=500
MAX_DURATION_SECONDS=600
TEMP_RETENTION_MINUTES=60
