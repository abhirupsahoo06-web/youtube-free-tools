# Worker HTTP Server
PORT=8787
ENHANCER_WORKER_SECRET=replace-with-shared-worker-bearer-secret
MAX_CONCURRENT_JOBS=2
TEMP_RETENTION_MINUTES=60

# S3-Compatible Object Storage (must match Vercel configuration)
S3_BUCKET=your-video-enhancer-bucket
S3_REGION=auto
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace-with-s3-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
S3_FORCE_PATH_STYLE=false

# Optional GPU AI Video Enhancement (Real-ESRGAN)
# Option A: External GPU inference HTTP endpoint accepting { inputUrl, targetWidth, targetHeight, aiStrength, denoise, temporalConsistency }
AI_ENHANCER_API_URL=
AI_ENHANCER_API_KEY=

# Option B: Local GPU binary path inside container (e.g. /usr/local/bin/realesrgan-ncnn-vulkan)
REALESRGAN_BIN_PATH=
REALESRGAN_MODEL=realesrgan-x4plus
